NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
SESSION_COOKIE_NAME=campaignhub_session
DATABASE_URL=postgresql://campaignhub:campaignhub_dev_password@localhost:5432/campaignhub

# Demo-only seed passwords. Change them before using any non-demo environment.
DEMO_ADMIN_PASSWORD=CampaignHub!2026
DEMO_MARKETER_PASSWORD=Marketing!2026
DEMO_VIEWER_PASSWORD=Viewer!2026

# Amazon SES will be configured in a later phase.
AWS_REGION=ap-south-1
SES_CONFIGURATION_SET=
SES_FROM_EMAIL=
