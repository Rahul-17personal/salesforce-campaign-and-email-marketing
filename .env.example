NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Use a long random value locally. In production, store in a secret manager.
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
SESSION_COOKIE_NAME=sf_marketing_session

# Salesforce External Client App (never expose these in frontend code or Git)
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:5173/api/auth/salesforce/callback
SF_SCOPES=api id refresh_token

# Optional in local development (in-memory sessions are used without Redis).
# Production requires Redis and a 32-byte AES-256 key (64 hex characters).
REDIS_URL=
TOKEN_ENCRYPTION_KEY_HEX=

# Amazon SES - Phase 5
AWS_REGION=ap-south-1
SES_CONFIGURATION_SET=
SES_FROM_EMAIL=
