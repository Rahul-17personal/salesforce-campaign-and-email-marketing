NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-local-secret-at-least-32-characters
SESSION_COOKIE_NAME=sf_marketing_session

# Salesforce External Client App OAuth configuration
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:4000/auth/salesforce/callback
SF_SCOPES=api id

# AWS SES: prefer workload IAM roles, not static access keys
AWS_REGION=ap-south-1
SES_CONFIGURATION_SET=
SES_FROM_EMAIL=

# Planned infrastructure
DATABASE_URL=
REDIS_URL=
